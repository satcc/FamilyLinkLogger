# Firebase Authentication 設定 (Firebase Console -> プロジェクト設定 -> 全般 -> アプリから取得)
# 未設定の場合は自動的にローカル開発モードとして動作します
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Family Link 対象メンバー設定 (JSON 形式: id と 表示名)
# 例: FAMILY_LINK_MEMBERS=[{"id":"1","name":"Child 1"},{"id":"2","name":"Child 2"}]
FAMILY_LINK_MEMBERS=

